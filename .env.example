# Runtime local. Estes valores são inertes e não devem ser reutilizados em produção.
NODE_ENV=development
PORT=3000
API_PORT=3333
NEXT_PUBLIC_API_URL=http://localhost:3333

# PostgreSQL local
POSTGRES_PORT=5433
POSTGRES_DB=fenix
POSTGRES_USER=fenix
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://fenix:replace-with-a-local-password@127.0.0.1:5433/fenix?schema=public
