# Runtime local. Estes valores são inertes e não devem ser reutilizados em produção.
NODE_ENV=development
PORT=3000
API_PORT=3333
# Interface de escuta da API. Mantenha loopback; use 0.0.0.0 apenas em contêiner atrás de proxy.
API_HOST=127.0.0.1
# Endereço interno usado pelo Next.js (servidor e proxy /api/v1) para chegar à API.
API_INTERNAL_URL=http://127.0.0.1:3333
# Origem pública da aplicação web; usada em CORS, validação de Origin e links de e-mail.
WEB_ORIGIN=http://localhost:3000

# Atualização imediata do site após mudanças no painel (DT-041). Mesmo valor na API e na web.
WEB_INTERNAL_URL=http://127.0.0.1:3000
SITE_REVALIDATE_SECRET=replace-with-a-long-random-secret

# PostgreSQL local
POSTGRES_PORT=5433
POSTGRES_DB=fenix
POSTGRES_USER=fenix
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://fenix:replace-with-a-local-password@127.0.0.1:5433/fenix?schema=public
# Testes de integração usam banco próprio, recriado a cada execução (DT-038). Opcional:
# sem esta variável, o nome é derivado de DATABASE_URL com o sufixo `_test`.
# DATABASE_URL_TEST=postgresql://fenix:replace-with-a-local-password@127.0.0.1:5433/fenix_test?schema=public

# Autenticação. Gere valores aleatórios longos (ex.: `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`).
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Chave de 32 bytes em base64 para cifrar PIX/dados bancários/documentos (AES-256-GCM).
DATA_ENCRYPTION_KEY=replace-with-32-bytes-base64

# Adaptadores locais (DT-024). Em produção exigem opt-in explícito.
STORAGE_DRIVER=local
# Use um caminho ABSOLUTO fora da pasta do projeto (DT-038): os arquivos sobrevivem a novo
# clone, limpeza da pasta e atualização. Em produção é obrigatório e deve ser um volume.
STORAGE_LOCAL_DIR=C:/FenixVolei-dados/storage
# E-mail (DT-048): `outbox` grava em arquivo (teste); `smtp` envia pelo provedor.
MAIL_DRIVER=outbox
MAIL_OUTBOX_DIR=var/mail-outbox
MAIL_FROM=Fênix Vôlei <nao-responda@fenix.example>
# SMTP_HOST=smtp.provedor.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=replace-with-smtp-user
# SMTP_PASSWORD=replace-with-smtp-password

# WhatsApp (DT-048): `outbox` grava em arquivo (teste, padrão fora de produção), `off`
# desliga (padrão em produção) e `cloud` envia pela WhatsApp Cloud API da Meta, com o
# modelo de mensagem aprovado (ver docs/15).
WHATSAPP_DRIVER=outbox
WHATSAPP_OUTBOX_DIR=var/whatsapp-outbox
# WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
# WHATSAPP_ACCESS_TOKEN=replace-with-system-user-token
# WHATSAPP_TEMPLATE_NAME=fenix_aviso
# WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
# WHATSAPP_API_VERSION=v23.0

# Escala (DT-047). Limite de requisições contado no PostgreSQL, comum a todos os servidores;
# `memory` só para desenvolvimento com um servidor. `SCHEDULED_JOBS=off` desliga as tarefas
# automáticas neste servidor (as outras instâncias continuam rodando).
THROTTLE_STORE=postgres
# SCHEDULED_JOBS=off

# Backup local (`npm run backup`): banco + arquivos. Caminho absoluto fora do projeto.
BACKUP_DIR=C:/FenixVolei-dados/backups
BACKUP_KEEP=30

# Conta administrativa inicial criada por `npm run db:seed` (somente se ainda não existir administrador).
SEED_ADMIN_EMAIL=admin@fenix.example
SEED_ADMIN_PASSWORD=replace-with-a-strong-local-password
SEED_ADMIN_NAME=Administrador Fênix
