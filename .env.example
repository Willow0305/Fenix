# Runtime local. Estes valores são inertes e não devem ser reutilizados em produção.
NODE_ENV=development
APP_ENV=development
PORT=3000
API_PORT=3333
NEXT_PUBLIC_API_URL=http://localhost:3333
CORS_ORIGINS=http://localhost:3000

# PostgreSQL local
POSTGRES_PORT=5433
POSTGRES_DB=fenix
POSTGRES_USER=fenix
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://fenix:replace-with-a-local-password@127.0.0.1:5433/fenix?schema=public

# Autenticação local. Gere valores exclusivos; nunca reutilize estes exemplos em produção.
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters-local
AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-characters-local
AUTH_CONTEXT_HASH_PEPPER=replace-with-at-least-32-random-characters-local
AUTH_BCRYPT_COST=12
AUTH_ACCESS_TOKEN_MINUTES=45
AUTH_INACTIVITY_MINUTES=45
AUTH_SESSION_ABSOLUTE_DAYS=30
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_FAILURE_WINDOW_MINUTES=15
AUTH_LOGIN_BLOCK_MINUTES=15
AUTH_RECOVERY_CODE_MINUTES=10
AUTH_RECOVERY_CODE_LENGTH=6
AUTH_MAX_RECOVERY_ATTEMPTS=5
AUTH_RECOVERY_BLOCK_MINUTES=15
AUTH_EMAIL_VERIFICATION_HOURS=24
AUTH_EMAIL_VERIFICATION_RESEND_SECONDS=60
AUTH_MFA_CHALLENGE_MINUTES=5
AUTH_MFA_RECOVERY_CODE_COUNT=10
AUTH_MFA_ENCRYPTION_KEY=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
AUTH_MFA_KEY_VERSION=local-v1
SPORTS_DUPLICATE_HMAC_KEY=fenix-local-sports-duplicate-hmac-key-v1
AUTH_COOKIE_SECURE=false
TRUST_PROXY_HOPS=0

# Rate limit distribuído local. Staging e produção exigem Redis.
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_RECOVERY_MAX=5
RATE_LIMIT_CODE_VALIDATION_MAX=10
RATE_LIMIT_EMAIL_RESEND_MAX=5
RATE_LIMIT_MFA_MAX=10
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_ADMIN_SENSITIVE_MAX=60

# E-mail local efêmero. Mailpit não representa um provedor de produção.
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@fenix.local
SMTP_TLS_REJECT_UNAUTHORIZED=true
EMAIL_DELIVERY_MODE=mailpit

# Política técnica aprovada em 27/07/2026.
RETENTION_CLOSED_ACCOUNT_DAYS=90
RETENTION_NON_CONVERTED_TRYOUT_DAYS=180
RETENTION_ATHLETE_GUARDIAN_DAYS=1825
RETENTION_FINANCIAL_DAYS=1825
RETENTION_ADMIN_AUDIT_DAYS=1825
RETENTION_SECURITY_LOG_DAYS=365
RETENTION_REVOKED_SESSION_DAYS=30
RETENTION_BACKUP_DAYS=35

# Gates institucionais: obrigatórios em staging/produção, sem nomes fictícios.
# RESPONSIBLE_TECHNOLOGY=
# RESPONSIBLE_PRIVACY=
# RESPONSIBLE_SECURITY=
# SECURITY_CONTACT_EMAIL=
# PRIVACY_CONTACT_EMAIL=
# PRODUCTION_RELEASE_APPROVED=false
REAL_MINOR_DATA_ENABLED=false
HEALTH_DATA_COLLECTION_ENABLED=false

# Identidade oficial. Contatos públicos permanecem vazios até decisão institucional.
NEXT_PUBLIC_ORGANIZATION_NAME=Fênix Vôlei
NEXT_PUBLIC_ORGANIZATION_DESCRIPTION=Gestão esportiva e administrativa do Fênix Vôlei
NEXT_PUBLIC_PRIMARY_LOGO_PATH=/brand/logo-fenix.png

# Defina somente no terminal/ambiente ao executar `npm run admin:bootstrap`.
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
