{
  "name": "@fenix/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "admin:bootstrap": "npm run build && node dist/bootstrap-admin.js",
    "build": "tsc -p tsconfig.build.json",
    "dev": "npm run build && concurrently --kill-others-on-fail --names typescript,server --prefix-colors yellow,magenta \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.spec.json"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.5",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "9.0.3",
    "qrcode": "^1.5.4",
    "redis": "^6.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/nodemailer": "7.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.20.6"
  }
}
