{
  "name": "@fenix/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --path tsconfig.dev.json",
    "start": "node dist/main.js",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand",
    "test:integration": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand --config jest.integration.config.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc --noEmit -p tsconfig.spec.json",
    "prisma:generate": "prisma generate --config ../../prisma.config.ts",
    "prebuild": "npm run build --workspace=@fenix/validation && npm run prisma:generate",
    "predev": "npm run build --workspace=@fenix/validation && npm run prisma:generate",
    "pretypecheck": "npm run build --workspace=@fenix/validation && npm run prisma:generate",
    "pretest": "npm run prisma:generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@fenix/validation": "0.1.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@types/cookie-parser": "1.4.10",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2"
  }
}
