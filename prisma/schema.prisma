  DIGITAL
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SOLD_OUT
  ARCHIVED
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  RESERVATION
  RELEASE
  ADJUSTMENT
  RETURN
  LOSS
}

enum SalesCampaignStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  ORDERED
  IN_PRODUCTION
  RECEIVED
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum OrderStatus {
  CREATED
  AWAITING_PAYMENT
  PAID
  PROCESSING
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PartnerSettlementStatus {
  DRAFT
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum ForumVisibility {
  PUBLIC
  MEMBERS
  STAFF
}

enum ForumTopicStatus {
  DRAFT
  PUBLISHED
  CLOSED
  HIDDEN
  ARCHIVED
}

enum ForumPostStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

enum ForumReactionType {
  LIKE
  SUPPORT
  CELEBRATE
}

enum ForumReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  HIDE
  RESTORE
  CLOSE
  REOPEN
  DELETE
  EDIT
}

enum NewsStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum EventType {
  TRYOUT
  MATCH
  FRIENDLY
  TRAINING
  COMMUNITY
  OTHER
}

enum EventStatus {
  DRAFT
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum PrivacyRequestType {
  DATA_EXPORT
  ERASURE
}

enum PrivacyRequestStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  name            String     @db.VarChar(160)
  email           String     @unique @db.VarChar(180)
  passwordHash    String     @map("password_hash") @db.Text
  phone           String?    @db.VarChar(30)
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  sessions                        UserSession[]
  tokens                          UserToken[]
  userRoles                       UserRole[]              @relation("UserRoleSubject")
  grantedUserRoles                UserRole[]              @relation("UserRoleGrantor")
  grantedRolePermissions          RolePermission[]        @relation("RolePermissionGrantor")
  athlete                         Athlete?
  interestedPerson                InterestedPerson?
  uploadedMedia                   MediaFile[]
  updatedTeamSettings             TeamSettings[]          @relation("TeamSettingsUpdater")
  registrationApplications        Registration[]          @relation("RegistrationApplicant")
  registrationsReviewed           Registration[]          @relation("RegistrationReviewer")
  tryoutApplications              TryoutRegistration[]    @relation("TryoutApplicant")
  tryoutRegistrationsReviewed     TryoutRegistration[]    @relation("TryoutReviewer")
  monthlyFeesCreated              MonthlyFee[]            @relation("MonthlyFeeCreator")
  monthlyFeesCancelled            MonthlyFee[]            @relation("MonthlyFeeCanceller")
  monthlyFeePaymentsCreated       MonthlyFeePayment[]
  paymentsMade                    Payment[]               @relation("PaymentPayer")
  paymentsCreated                 Payment[]               @relation("PaymentCreator")
  refundsRequested                Refund[]                @relation("RefundRequester")
  refundsApproved                 Refund[]                @relation("RefundApprover")
  financialObligationsCreated     FinancialObligation[]   @relation("FinancialObligationCreator")
  financialObligationsCancelled   FinancialObligation[]   @relation("FinancialObligationCanceller")
  financialTransactionsCreated    FinancialTransaction[]  @relation("FinancialTransactionCreator")
  financialTransactionsConfirmed  FinancialTransaction[]  @relation("FinancialTransactionConfirmer")
  financialTransactionsCancelled  FinancialTransaction[]  @relation("FinancialTransactionCanceller")
  financialTransactionsReconciled FinancialTransaction[]  @relation("FinancialTransactionReconciler")
  financialTransfersCreated       FinancialTransfer[]
  cashClosingsClosed              CashClosing[]           @relation("CashClosingCloser")
  cashClosingsReopened            CashClosing[]           @relation("CashClosingReopener")
  inventoryMovementsCreated       InventoryMovement[]
  salesCampaignsCreated           SalesCampaign[]
  orders                          Order[]
  partnerProfessional             PartnerProfessional?
  appointments                    Appointment[]
  partnerSettlementsCreated       PartnerSettlement[]     @relation("PartnerSettlementCreator")
  partnerSettlementsApproved      PartnerSettlement[]     @relation("PartnerSettlementApprover")
  forumTopics                     ForumTopic[]
  forumPosts                      ForumPost[]
  forumReactions                  ForumReaction[]
  forumReports                    ForumReport[]           @relation("ForumReportReporter")
  forumReportsReviewed            ForumReport[]           @relation("ForumReportReviewer")
  forumModerationActions          ForumModerationAction[]
  newsAuthored                    News[]
  notifications                   Notification[]
  auditLogs                       AuditLog[]
  favorites                       Favorite[]
  carts                           Cart[]
  privacyRequests                 PrivacyRequest[]        @relation("PrivacyRequestSubject")
  privacyRequestsHandled          PrivacyRequest[]        @relation("PrivacyRequestHandler")

  @@index([status, deletedAt])
  @@map("users")
}

model UserSession {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  refreshTokenHash     String    @unique @map("refresh_token_hash") @db.Char(64)
  rotatedFromSessionId String?   @map("rotated_from_session_id") @db.Uuid
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason     String?   @map("revocation_reason") @db.VarChar(250)
  userAgentHash        String?   @map("user_agent_hash") @db.Char(64)
  ipAddressHash        String?   @map("ip_address_hash") @db.Char(64)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rotatedFrom     UserSession?  @relation("SessionRotation", fields: [rotatedFromSessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rotatedSessions UserSession[] @relation("SessionRotation")

  @@index([userId, revokedAt, expiresAt])
  @@map("user_sessions")
}

model UserToken {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  type       UserTokenType
  tokenHash  String        @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?     @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, type, expiresAt])
  @@map("user_tokens")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(100)
  name        String    @db.VarChar(120)
  description String?   @db.Text
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([deletedAt, name])
  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(140)
  name        String    @db.VarChar(140)
  description String?   @db.Text
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@index([deletedAt, name])
  @@map("permissions")
}

model UserRole {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  grantedById String?   @map("granted_by_id") @db.Uuid
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User  @relation("UserRoleSubject", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grantedBy User? @relation("UserRoleGrantor", fields: [grantedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([userId, roleId])
  @@index([roleId, expiresAt])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedById  String?  @map("granted_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grantedBy  User?      @relation("RolePermissionGrantor", fields: [grantedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model TeamSettings {
  id                      String   @id @default(uuid()) @db.Uuid
  singletonKey            String   @unique @map("singleton_key") @db.VarChar(40)
  teamName                String   @map("team_name") @db.VarChar(160)
  officialName            String   @map("official_name") @db.VarChar(200)
  description             String?  @db.Text
  history                 String?  @db.Text
  email                   String?  @db.VarChar(180)
  phone                   String?  @db.VarChar(30)
  socialLinks             Json?    @map("social_links") @db.JsonB
  addressLine1            String?  @map("address_line_1") @db.VarChar(200)
  addressLine2            String?  @map("address_line_2") @db.VarChar(200)
  addressCity             String?  @map("address_city") @db.VarChar(120)
  addressState            String?  @map("address_state") @db.VarChar(80)
  addressPostalCode       String?  @map("address_postal_code") @db.VarChar(20)
  addressCountry          String?  @map("address_country") @db.Char(2)
  primaryColor            String?  @map("primary_color") @db.VarChar(20)
  secondaryColor          String?  @map("secondary_color") @db.VarChar(20)
  defaultCurrency         String   @map("default_currency") @db.Char(3)
  timeZone                String   @map("time_zone") @db.VarChar(100)
  pixKeyEncrypted         String?  @map("pix_key_encrypted") @db.Text
  bankingDetailsEncrypted String?  @map("banking_details_encrypted") @db.Text
  encryptionKeyVersion    String?  @map("encryption_key_version") @db.VarChar(40)
  termsOfUse              String?  @map("terms_of_use") @db.Text
  privacyPolicy           String?  @map("privacy_policy") @db.Text
  monthlyFeeRules         String?  @map("monthly_fee_rules") @db.Text
  storeRules              String?  @map("store_rules") @db.Text
  pickupInstructions      String?  @map("pickup_instructions") @db.Text
  notificationSettings    Json?    @map("notification_settings") @db.JsonB
  updatedById             String?  @map("updated_by_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy   User?            @relation("TeamSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  brandAssets TeamBrandAsset[]

  @@map("team_settings")
}

model TeamBrandAsset {
  id             String           @id @default(uuid()) @db.Uuid
  teamSettingsId String           @map("team_settings_id") @db.Uuid
  mediaFileId    String           @map("media_file_id") @db.Uuid
  context        TeamBrandContext
  altText        String?          @map("alt_text") @db.VarChar(180)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  teamSettings TeamSettings @relation(fields: [teamSettingsId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mediaFile    MediaFile    @relation(fields: [mediaFileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([teamSettingsId, context])
  @@index([mediaFileId])
  @@map("team_brand_assets")
}

model MediaFile {
  id              String             @id @default(uuid()) @db.Uuid
  storageProvider String             @map("storage_provider") @db.VarChar(80)
  bucket          String             @db.VarChar(180)
  objectKey       String             @map("object_key") @db.VarChar(500)
  originalName    String             @map("original_name") @db.VarChar(255)
  mimeType        String             @map("mime_type") @db.VarChar(150)
  extension       String?            @db.VarChar(20)
  sizeBytes       BigInt             @map("size_bytes") @db.BigInt
  checksumSha256  String             @map("checksum_sha256") @db.Char(64)
  kind            MediaKind
  classification  DataClassification
  isVerified      Boolean            @default(false) @map("is_verified")
  verifiedAt      DateTime?          @map("verified_at") @db.Timestamptz(6)
  uploadedById    String?            @map("uploaded_by_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(6)

  uploadedBy           User?                            @relation(fields: [uploadedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  teamBrandAssets      TeamBrandAsset[]
  athleteDocuments     AthleteDocument[]
  financialAttachments FinancialTransactionAttachment[]
  partnerLogos         Partner[]
  partnerDocuments     PartnerDocument[]
  productImages        ProductImage[]
  newsCovers           News[]

  @@unique([storageProvider, bucket, objectKey])
  @@index([classification, kind, deletedAt])
  @@index([checksumSha256])
  @@map("media_files")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String   @db.VarChar(140)
  entityType    String   @map("entity_type") @db.VarChar(140)
  entityId      String?  @map("entity_id") @db.Uuid
  reason        String?  @db.Text
  beforeData    Json?    @map("before_data") @db.JsonB
  afterData     Json?    @map("after_data") @db.JsonB
  metadata      Json?    @db.JsonB
  requestId     String?  @map("request_id") @db.Uuid
  ipAddressHash String?  @map("ip_address_hash") @db.Char(64)
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([entityType, entityId, occurredAt])
  @@index([action, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([requestId])
  @@map("audit_logs")
}

model Athlete {
  id                      String        @id @default(uuid()) @db.Uuid
  userId                  String?       @unique @map("user_id") @db.Uuid
  fullName                String        @map("full_name") @db.VarChar(160)
  preferredName           String?       @map("preferred_name") @db.VarChar(120)
  birthDate               DateTime?     @map("birth_date") @db.Date
  documentNumberEncrypted String?       @map("document_number_encrypted") @db.Text
  documentNumberHash      String?       @unique @map("document_number_hash") @db.Char(64)
  email                   String?       @db.VarChar(180)
  phone                   String?       @db.VarChar(30)
  gender                  Gender?
  position                String?       @db.VarChar(80)
  emergencyContactName    String?       @map("emergency_contact_name") @db.VarChar(160)
  emergencyContactPhone   String?       @map("emergency_contact_phone") @db.VarChar(30)
  guardianName            String?       @map("guardian_name") @db.VarChar(160)
  guardianPhone           String?       @map("guardian_phone") @db.VarChar(30)
  guardianAcknowledgedAt  DateTime?     @map("guardian_acknowledged_at") @db.Timestamptz(6)
  status                  AthleteStatus @default(PENDING)
  notes                   String?       @db.Text
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?     @map("deleted_at") @db.Timestamptz(6)

  user                      User?                   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  documents                 AthleteDocument[]
  teamMemberships           TeamAthlete[]
  resultingRegistrations    Registration[]          @relation("RegistrationResultAthlete")
  tryoutRegistrations       TryoutRegistration[]
  convertedInterestedPeople InterestedPerson[]      @relation("InterestedPersonConversion")
  monthlyFeePlans           AthleteMonthlyFeePlan[]
  monthlyFees               MonthlyFee[]
  appointments              Appointment[]

  @@index([status, deletedAt])
  @@index([fullName, deletedAt])
  @@map("athletes")
}

model AthleteDocument {
  id                      String    @id @default(uuid()) @db.Uuid
  athleteId               String    @map("athlete_id") @db.Uuid
  mediaFileId             String    @map("media_file_id") @db.Uuid
  documentType            String    @map("document_type") @db.VarChar(80)
  documentNumberEncrypted String?   @map("document_number_encrypted") @db.Text
  documentNumberHash      String?   @map("document_number_hash") @db.Char(64)
  issuedOn                DateTime? @map("issued_on") @db.Date
  expiresOn               DateTime? @map("expires_on") @db.Date
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz(6)

  athlete   Athlete   @relation(fields: [athleteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([athleteId, mediaFileId])
  @@index([athleteId, documentType, deletedAt])
  @@index([expiresOn])
  @@map("athlete_documents")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(140)
  description String?   @db.Text
  minimumAge  Int?      @map("minimum_age") @db.SmallInt
  maximumAge  Int?      @map("maximum_age") @db.SmallInt
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  teams Team[]

  @@index([isActive, deletedAt])
