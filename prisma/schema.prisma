  referenceCode   String                    @unique @map("reference_code") @db.VarChar(80)
  description     String                    @db.VarChar(220)
  counterpartyRef String?                   @map("counterparty_ref") @db.VarChar(160)
  dueDate         DateTime                  @map("due_date") @db.Date
  amount          Decimal                   @db.Decimal(19, 4)
  currency        String                    @default("BRL") @db.Char(3)
  createdById     String                    @map("created_by_id") @db.Uuid
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  cancelledAt     DateTime?                 @map("cancelled_at") @db.Timestamptz(6)

  category     FinancialCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  costCenter   CostCenter?            @relation(fields: [costCenterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  account      FinancialAccount?      @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy    User                   @relation("FinancialObligationCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transactions FinancialTransaction[]

  @@index([type, status, dueDate])
  @@index([categoryId, dueDate])
  @@index([costCenterId, dueDate])
  @@map("financial_obligations")
}

model CashSession {
  id             String            @id @default(uuid()) @db.Uuid
  accountId      String            @map("account_id") @db.Uuid
  openingBalance Decimal           @map("opening_balance") @db.Decimal(19, 4)
  status         CashSessionStatus @default(OPEN)
  openedById     String            @map("opened_by_id") @db.Uuid
  openedAt       DateTime          @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt       DateTime?         @map("closed_at") @db.Timestamptz(6)

  account      FinancialAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  openedBy     User                   @relation("CashSessionOpener", fields: [openedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transactions FinancialTransaction[]
  closing      CashClosing?

  @@index([accountId, status, openedAt])
  @@map("cash_sessions")
}

model CashClosing {
  id                   String   @id @default(uuid()) @db.Uuid
  cashSessionId        String   @unique @map("cash_session_id") @db.Uuid
  openingBalance       Decimal  @map("opening_balance") @db.Decimal(19, 4)
  inflows              Decimal  @db.Decimal(19, 4)
  outflows             Decimal  @db.Decimal(19, 4)
  adjustments          Decimal  @db.Decimal(19, 4)
  expectedFinalBalance Decimal  @map("expected_final_balance") @db.Decimal(19, 4)
  countedFinalBalance  Decimal  @map("counted_final_balance") @db.Decimal(19, 4)
  differenceAmount     Decimal  @map("difference_amount") @db.Decimal(19, 4)
  reason               String?  @db.VarChar(250)
  closedById           String   @map("closed_by_id") @db.Uuid
  closedAt             DateTime @default(now()) @map("closed_at") @db.Timestamptz(6)

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  closedBy    User        @relation("CashClosingCloser", fields: [closedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([closedById, closedAt])
  @@map("cash_closings")
}

model FinancialTransaction {
  id                 String                     @id @default(uuid()) @db.Uuid
  accountId          String                     @map("account_id") @db.Uuid
  categoryId         String?                    @map("category_id") @db.Uuid
  costCenterId       String?                    @map("cost_center_id") @db.Uuid
  paymentId          String?                    @map("payment_id") @db.Uuid
  transferId         String?                    @map("transfer_id") @db.Uuid
  obligationId       String?                    @map("obligation_id") @db.Uuid
  cashSessionId      String?                    @map("cash_session_id") @db.Uuid
  reversalOfId       String?                    @unique @map("reversal_of_id") @db.Uuid
  type               FinancialTransactionType
  status             FinancialTransactionStatus @default(PENDING)
  amount             Decimal                    @db.Decimal(19, 4)
  currency           String                     @default("BRL") @db.Char(3)
  description        String                     @db.VarChar(220)
  occurredAt         DateTime                   @map("occurred_at") @db.Timestamptz(6)
  idempotencyKeyHash String                     @unique @map("idempotency_key_hash") @db.Char(64)
  createdById        String                     @map("created_by_id") @db.Uuid
  approvedById       String?                    @map("approved_by_id") @db.Uuid
  approvedAt         DateTime?                  @map("approved_at") @db.Timestamptz(6)
  rejectedById       String?                    @map("rejected_by_id") @db.Uuid
  rejectedAt         DateTime?                  @map("rejected_at") @db.Timestamptz(6)
  rejectionReason    String?                    @map("rejection_reason") @db.VarChar(250)
  reversedById       String?                    @map("reversed_by_id") @db.Uuid
  reversedAt         DateTime?                  @map("reversed_at") @db.Timestamptz(6)
  reversalReason     String?                    @map("reversal_reason") @db.VarChar(250)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  account     FinancialAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category    FinancialCategory?    @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  costCenter  CostCenter?           @relation(fields: [costCenterId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payment     FinancialPayment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transfer    FinancialTransfer?    @relation(fields: [transferId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  obligation  FinancialObligation?  @relation(fields: [obligationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cashSession CashSession?          @relation(fields: [cashSessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversalOf  FinancialTransaction? @relation("FinancialTransactionReversal", fields: [reversalOfId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversal    FinancialTransaction? @relation("FinancialTransactionReversal")
  createdBy   User                  @relation("FinancialTransactionCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedBy  User?                 @relation("FinancialTransactionApprover", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rejectedBy  User?                 @relation("FinancialTransactionRejector", fields: [rejectedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reversedBy  User?                 @relation("FinancialTransactionReverser", fields: [reversedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([accountId, status, occurredAt])
  @@index([categoryId, status, occurredAt])
  @@index([costCenterId, status, occurredAt])
  @@index([paymentId])
  @@index([transferId])
  @@index([obligationId])
  @@index([cashSessionId, status, occurredAt])
  @@map("financial_transactions")
}
