  channel          NotificationChannel        @default(IN_APP)
  deliveryStatus   NotificationDeliveryStatus @default(PENDING) @map("delivery_status")
  payload          Json?                      @db.JsonB
  deduplicationKey String?                    @map("deduplication_key") @db.VarChar(160)
  scheduledAt      DateTime?                  @map("scheduled_at") @db.Timestamptz(6)
  sentAt           DateTime?                  @map("sent_at") @db.Timestamptz(6)
  readAt           DateTime?                  @map("read_at") @db.Timestamptz(6)
  failureCode      String?                    @map("failure_code") @db.VarChar(100)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?                  @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, deduplicationKey])
  @@index([deduplicationKey])
  @@index([userId, readAt, createdAt])
  @@index([deliveryStatus, scheduledAt])
  @@index([type, createdAt])
  @@map("notifications")
}

model PrivacyRequest {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  type        PrivacyRequestType
  status      PrivacyRequestStatus @default(OPEN)
  details     String?              @db.Text
  resolution  String?              @db.Text
  handledById String?              @map("handled_by_id") @db.Uuid
  handledAt   DateTime?            @map("handled_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User  @relation("PrivacyRequestSubject", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  handledBy User? @relation("PrivacyRequestHandler", fields: [handledById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("privacy_requests")
}
