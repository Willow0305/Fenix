generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED
}

enum UserTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  MFA_LOGIN_CHALLENGE
}

enum DataSubjectRequestType {
  ACCESS
  CORRECTION
  ANONYMIZATION
  DELETION
  PORTABILITY
  CONSENT_REVOCATION
  INFORMATION
}

enum DataSubjectRequestStatus {
  RECEIVED
  IDENTITY_VERIFICATION_PENDING
  IN_REVIEW
  COMPLETED
  REJECTED
  CANCELLED
}

enum RetentionRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum PrivateAttachmentStatus {
  PENDING
  AVAILABLE
  QUARANTINED
  REMOVED
}

enum SportCategoryKind {
  AGE_GROUP
  GENDER
  LEVEL
  DIVISION
  OTHER
}

enum AthleteProfileStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum GuardianAuthorizationStatus {
  PENDING
  VALID
  REVOKED
  EXPIRED
}

enum TryoutStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

enum TryoutRegistrationStatus {
  NEW
  UNDER_REVIEW
  WAITLISTED
  APPROVED
  REJECTED
  ATTENDED
  NO_SHOW
  CONVERTED
  CANCELLED
}

enum SportsImportKind {
  ATHLETE_PROFILE
  TRYOUT_REGISTRATION
}

enum ImportBatchStatus {
  CREATED
  VALIDATING
  VALIDATED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  PENDING
  VALID
  INVALID
  IMPORTED
  SKIPPED
  FAILED
}

enum FinancialAccountType {
  CASH
  BANK
  DIGITAL_WALLET
  OTHER
}

enum FinancialCategoryType {
  INCOME
  EXPENSE
}

enum FinancialPlanStatus {
  ACTIVE
  INACTIVE
}

enum FinancialChargeStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum FinancialPaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REVERSED
}

enum FinancialSurplusDisposition {
  CREDIT
  RETURN_PENDING
  REVIEW_REQUIRED
}

enum PaymentCreditStatus {
  OPEN
  PARTIALLY_USED
  USED
  REFUND_PENDING
  CANCELLED
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  REVERSAL
}

enum FinancialTransactionStatus {
  PENDING
  APPROVED
  REJECTED
  REVERSED
}

enum FinancialTransferStatus {
  PENDING
  APPROVED
  REJECTED
  REVERSED
}

enum FinancialObligationType {
  PAYABLE
  RECEIVABLE
}

enum FinancialObligationStatus {
  OPEN
  PARTIALLY_SETTLED
  SETTLED
  CANCELLED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model User {
  id                          String     @id @default(uuid()) @db.Uuid
  name                        String     @db.VarChar(160)
  email                       String     @unique @db.VarChar(180)
  passwordHash                String     @map("password_hash") @db.Text
  status                      UserStatus @default(PENDING)
  emailVerifiedAt             DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  failedLoginAttempts         Int        @default(0) @map("failed_login_attempts")
  loginFailureWindowStartedAt DateTime?  @map("login_failure_window_started_at") @db.Timestamptz(6)
  blockedUntil                DateTime?  @map("blocked_until") @db.Timestamptz(6)
  lastLoginAt                 DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt                   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                   DateTime?  @map("deleted_at") @db.Timestamptz(6)

  sessions                      UserSession[]
  tokens                        UserToken[]
  mfaCredential                 MfaCredential?
  userRoles                     UserRole[]                  @relation("UserRoleSubject")
  grantedUserRoles              UserRole[]                  @relation("UserRoleGrantor")
  grantedRolePermissions        RolePermission[]            @relation("RolePermissionGrantor")
  auditLogs                     AuditLog[]
  dataSubjectRequests           DataSubjectRequest[]        @relation("DataSubject")
  handledPrivacyRequests        DataSubjectRequest[]        @relation("PrivacyRequestHandler")
  initiatedRetentionRuns        RetentionRun[]              @relation("RetentionRunInitiator")
  createdAttachments            PrivateAttachment[]         @relation("PrivateAttachmentCreator")
  athleteProfile                AthleteProfile?             @relation("AthleteProfileUser")
  guardianProfile               Guardian?                   @relation("GuardianUser")
  createdTeamCategories         TeamCategory[]              @relation("TeamCategoryCreator")
  assignedAffiliations          AthleteAffiliation[]        @relation("AthleteAffiliationAssigner")
  endedAffiliations             AthleteAffiliation[]        @relation("AthleteAffiliationEnder")
  createdGuardianLinks          AthleteGuardian[]           @relation("AthleteGuardianCreator")
  verifiedAuthorizations        GuardianAuthorization[]     @relation("GuardianAuthorizationVerifier")
  revokedAuthorizations         GuardianAuthorization[]     @relation("GuardianAuthorizationRevoker")
  managedTryouts                Tryout[]                    @relation("TryoutResponsible")
  tryoutApplications            TryoutRegistration[]        @relation("TryoutApplicant")
  reviewedRegistrations         TryoutRegistration[]        @relation("TryoutReviewer")
  registrationChanges           TryoutRegistrationHistory[] @relation("TryoutRegistrationChanger")
  createdImportBatches          ImportBatch[]               @relation("SportsImportCreator")
  processedImportBatches        ImportBatch[]               @relation("SportsImportProcessor")
  createdFinancialAccounts      FinancialAccount[]          @relation("FinancialAccountCreator")
  createdFinancialCategories    FinancialCategory[]         @relation("FinancialCategoryCreator")
  createdCostCenters            CostCenter[]                @relation("CostCenterCreator")
  createdFinancialPlans         FinancialPlan[]             @relation("FinancialPlanCreator")
  createdFinancialPlanVersions  FinancialPlanVersion[]      @relation("FinancialPlanVersionCreator")
  createdFinancialCharges       FinancialCharge[]           @relation("FinancialChargeCreator")
  createdFinancialPayments      FinancialPayment[]          @relation("FinancialPaymentCreator")
  approvedFinancialPayments     FinancialPayment[]          @relation("FinancialPaymentApprover")
  createdPaymentAllocations     PaymentAllocation[]         @relation("PaymentAllocationCreator")
  createdReconciliations        FinancialReconciliation[]   @relation("FinancialReconciliationCreator")
  createdFinancialTransactions  FinancialTransaction[]      @relation("FinancialTransactionCreator")
  approvedFinancialTransactions FinancialTransaction[]      @relation("FinancialTransactionApprover")
  rejectedFinancialTransactions FinancialTransaction[]      @relation("FinancialTransactionRejector")
  reversedFinancialTransactions FinancialTransaction[]      @relation("FinancialTransactionReverser")
  initiatedFinancialTransfers   FinancialTransfer[]         @relation("FinancialTransferInitiator")
  approvedFinancialTransfers    FinancialTransfer[]         @relation("FinancialTransferApprover")
  rejectedFinancialTransfers    FinancialTransfer[]         @relation("FinancialTransferRejector")
  reversedFinancialTransfers    FinancialTransfer[]         @relation("FinancialTransferReverser")
  createdFinancialObligations   FinancialObligation[]       @relation("FinancialObligationCreator")
  openedCashSessions            CashSession[]               @relation("CashSessionOpener")
  closedCashSessions            CashClosing[]               @relation("CashClosingCloser")

  @@index([status, deletedAt])
  @@index([emailVerifiedAt, status])
  @@map("users")
}

model UserSession {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  refreshTokenHash     String    @unique @map("refresh_token_hash") @db.Text
  csrfTokenHash        String    @map("csrf_token_hash") @db.Text
  rotatedFromSessionId String?   @unique @map("rotated_from_session_id") @db.Uuid
  lastActivityAt       DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  absoluteExpiresAt    DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  mfaVerifiedAt        DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason     String?   @map("revocation_reason") @db.VarChar(250)
  userAgentHash        String?   @map("user_agent_hash") @db.Text
  ipAddressHash        String?   @map("ip_address_hash") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rotatedFrom     UserSession?  @relation("SessionRotation", fields: [rotatedFromSessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rotatedSessions UserSession[] @relation("SessionRotation")

  @@index([userId, revokedAt, expiresAt])
  @@map("user_sessions")
}

model UserToken {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  type           UserTokenType
  tokenHash      String        @unique @map("token_hash") @db.Text
  failedAttempts Int           @default(0) @map("failed_attempts")
  blockedUntil   DateTime?     @map("blocked_until") @db.Timestamptz(6)
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime?     @map("consumed_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, type, expiresAt])
  @@map("user_tokens")
}

model MfaCredential {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  secretCiphertext String    @map("secret_ciphertext") @db.Text
  secretIv         String    @map("secret_iv") @db.VarChar(64)
  secretAuthTag    String    @map("secret_auth_tag") @db.VarChar(64)
  keyVersion       String    @map("key_version") @db.VarChar(50)
  lastTotpStep     Int?      @map("last_totp_step")
  confirmedAt      DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recoveryCodes MfaRecoveryCode[]

  @@index([confirmedAt])
  @@map("mfa_credentials")
}

model MfaRecoveryCode {
  id           String    @id @default(uuid()) @db.Uuid
  credentialId String    @map("credential_id") @db.Uuid
  codeHash     String    @unique @map("code_hash") @db.Text
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  credential MfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([credentialId, usedAt])
  @@map("mfa_recovery_codes")
}

model DataSubjectRequest {
  id             String                   @id @default(uuid()) @db.Uuid
  subjectUserId  String?                  @map("subject_user_id") @db.Uuid
  requesterEmail String                   @map("requester_email") @db.VarChar(180)
  type           DataSubjectRequestType
  status         DataSubjectRequestStatus @default(RECEIVED)
  protocol       String                   @unique @db.VarChar(40)
  channel        String                   @db.VarChar(80)
  description    String?                  @db.Text
  decisionReason String?                  @map("decision_reason") @db.Text
  handledById    String?                  @map("handled_by_id") @db.Uuid
  receivedAt     DateTime                 @default(now()) @map("received_at") @db.Timestamptz(6)
  dueAt          DateTime?                @map("due_at") @db.Timestamptz(6)
  completedAt    DateTime?                @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  subjectUser User? @relation("DataSubject", fields: [subjectUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  handledBy   User? @relation("PrivacyRequestHandler", fields: [handledById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, receivedAt])
  @@index([subjectUserId, receivedAt])
  @@map("data_subject_requests")
}

model RetentionRun {
  id            String             @id @default(uuid()) @db.Uuid
  status        RetentionRunStatus @default(RUNNING)
  dryRun        Boolean            @default(true) @map("dry_run")
  policyVersion String             @map("policy_version") @db.VarChar(50)
  summary       Json?              @db.JsonB
  errorCode     String?            @map("error_code") @db.VarChar(100)
  initiatedById String?            @map("initiated_by_id") @db.Uuid
  startedAt     DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?          @map("completed_at") @db.Timestamptz(6)

  initiatedBy User? @relation("RetentionRunInitiator", fields: [initiatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, startedAt])
  @@map("retention_runs")
}

model PrivateAttachment {
  id                  String                  @id @default(uuid()) @db.Uuid
  purpose             String                  @db.VarChar(100)
  status              PrivateAttachmentStatus @default(PENDING)
  objectKeyCiphertext String                  @map("object_key_ciphertext") @db.Text
  objectKeyIv         String                  @map("object_key_iv") @db.VarChar(64)
  objectKeyAuthTag    String                  @map("object_key_auth_tag") @db.VarChar(64)
  keyVersion          String                  @map("key_version") @db.VarChar(50)
  originalName        String                  @map("original_name") @db.VarChar(255)
  mimeType            String                  @map("mime_type") @db.VarChar(120)
  sizeBytes           BigInt                  @map("size_bytes")
  checksumSha256      String                  @map("checksum_sha256") @db.Char(64)
  retentionUntil      DateTime?               @map("retention_until") @db.Timestamptz(6)
  createdById         String?                 @map("created_by_id") @db.Uuid
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  removedAt           DateTime?               @map("removed_at") @db.Timestamptz(6)

  createdBy             User?                  @relation("PrivateAttachmentCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  guardianAuthorization GuardianAuthorization?
  sportsImportBatch     ImportBatch?
  financialPayment      FinancialPayment?

  @@index([purpose, status, retentionUntil])
  @@map("private_attachments")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(100)
  name        String    @db.VarChar(120)
  description String?   @db.Text
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([deletedAt, name])
  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(140)
  name        String    @db.VarChar(140)
  description String?   @db.Text
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@index([deletedAt, name])
  @@map("permissions")
}

model UserRole {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  grantedById String?   @map("granted_by_id") @db.Uuid
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User  @relation("UserRoleSubject", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grantedBy User? @relation("UserRoleGrantor", fields: [grantedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([userId, roleId])
  @@index([roleId, expiresAt])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedById  String?  @map("granted_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grantedBy  User?      @relation("RolePermissionGrantor", fields: [grantedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String   @db.VarChar(120)
  entityType    String   @map("entity_type") @db.VarChar(120)
  entityId      String?  @map("entity_id") @db.Uuid
  reason        String?  @db.VarChar(250)
  beforeData    Json?    @map("before_data") @db.JsonB
  afterData     Json?    @map("after_data") @db.JsonB
  metadata      Json?    @db.JsonB
  requestId     String?  @map("request_id") @db.Uuid
  ipAddressHash String?  @map("ip_address_hash") @db.Text
  userAgentHash String?  @map("user_agent_hash") @db.Text
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([requestId])
  @@index([action, occurredAt])
  @@map("audit_logs")
}

model Category {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique @db.VarChar(50)
  name        String            @db.VarChar(120)
  slug        String            @unique @db.VarChar(140)
  kind        SportCategoryKind
  description String?           @db.Text
  minimumAge  Int?              @map("minimum_age") @db.SmallInt
  maximumAge  Int?              @map("maximum_age") @db.SmallInt
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz(6)

  teamCategories TeamCategory[]

  @@index([kind, isActive, deletedAt])
  @@map("sport_categories")
}

model Team {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(120)
  slug        String    @unique @db.VarChar(140)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  categories TeamCategory[]

  @@index([isActive, deletedAt])
  @@map("teams")
}

model TeamCategory {
  id          String    @id @default(uuid()) @db.Uuid
  teamId      String    @map("team_id") @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  startsOn    DateTime  @map("starts_on") @db.Date
  endsOn      DateTime? @map("ends_on") @db.Date
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  team         Team                 @relation(fields: [teamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy    User?                @relation("TeamCategoryCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  affiliations AthleteAffiliation[]
  tryouts      Tryout[]

  @@unique([teamId, categoryId, startsOn])
  @@index([teamId, endsOn, deletedAt])
  @@index([categoryId, endsOn, deletedAt])
  @@map("team_categories")
}

model AthleteProfile {
  id                       String               @id @default(uuid()) @db.Uuid
  userId                   String?              @unique @map("user_id") @db.Uuid
  fullName                 String               @map("full_name") @db.VarChar(160)
  preferredName            String?              @map("preferred_name") @db.VarChar(120)
  birthDate                DateTime             @map("birth_date") @db.Date
  position                 String?              @db.VarChar(80)
  status                   AthleteProfileStatus @default(PENDING)
  duplicateFingerprintHash String               @map("duplicate_fingerprint_hash") @db.VarChar(80)
  isFictitious             Boolean              @default(true) @map("is_fictitious")
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?            @map("deleted_at") @db.Timestamptz(6)

  user                   User?                   @relation("AthleteProfileUser", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  affiliations           AthleteAffiliation[]
  guardians              AthleteGuardian[]
  guardianAuthorizations GuardianAuthorization[]
  sourceRegistration     TryoutRegistration?     @relation("TryoutConversion")

  @@index([status, deletedAt])
  @@index([duplicateFingerprintHash, deletedAt])
  @@index([fullName, deletedAt])
  @@map("athlete_profiles")
}

model AthleteAffiliation {
  id               String    @id @default(uuid()) @db.Uuid
  athleteProfileId String    @map("athlete_profile_id") @db.Uuid
  teamCategoryId   String    @map("team_category_id") @db.Uuid
  startsOn         DateTime  @map("starts_on") @db.Date
  endsOn           DateTime? @map("ends_on") @db.Date
  assignedById     String?   @map("assigned_by_id") @db.Uuid
  endedById        String?   @map("ended_by_id") @db.Uuid
  reason           String?   @db.VarChar(250)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  athleteProfile AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  teamCategory   TeamCategory   @relation(fields: [teamCategoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedBy     User?          @relation("AthleteAffiliationAssigner", fields: [assignedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  endedBy        User?          @relation("AthleteAffiliationEnder", fields: [endedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([athleteProfileId, teamCategoryId, startsOn], map: "athlete_affiliations_athlete_profile_id_team_category_id_starts")
  @@index([athleteProfileId, endsOn])
  @@index([teamCategoryId, endsOn])
  @@map("athlete_affiliations")
}

model Guardian {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String?   @unique @map("user_id") @db.Uuid
  fullName     String    @map("full_name") @db.VarChar(160)
  email        String?   @db.VarChar(180)
  phone        String?   @db.VarChar(30)
