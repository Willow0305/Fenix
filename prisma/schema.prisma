  id                    String                     @id @default(uuid()) @db.Uuid
  accountId             String                     @map("account_id") @db.Uuid
  categoryId            String                     @map("category_id") @db.Uuid
  costCenterId          String?                    @map("cost_center_id") @db.Uuid
  paymentMethodId       String?                    @map("payment_method_id") @db.Uuid
  paymentId             String?                    @unique @map("payment_id") @db.Uuid
  refundId              String?                    @unique @map("refund_id") @db.Uuid
  partnerSettlementId   String?                    @unique @map("partner_settlement_id") @db.Uuid
  reversesTransactionId String?                    @map("reverses_transaction_id") @db.Uuid
  cashClosingId         String?                    @map("cash_closing_id") @db.Uuid
  direction             FinancialDirection
  origin                FinancialOrigin
  status                FinancialTransactionStatus @default(DRAFT)
  amount                Decimal                    @db.Decimal(19, 4)
  currency              String                     @db.Char(3)
  competenceDate        DateTime                   @map("competence_date") @db.Date
  dueDate               DateTime?                  @map("due_date") @db.Date
  occurredAt            DateTime?                  @map("occurred_at") @db.Timestamptz(6)
  confirmedAt           DateTime?                  @map("confirmed_at") @db.Timestamptz(6)
  description           String                     @db.Text
  notes                 String?                    @db.Text
  idempotencyKey        String                     @unique @map("idempotency_key") @db.VarChar(160)
  createdById           String?                    @map("created_by_id") @db.Uuid
  confirmedById         String?                    @map("confirmed_by_id") @db.Uuid
  cancelledById         String?                    @map("cancelled_by_id") @db.Uuid
  cancelledAt           DateTime?                  @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason    String?                    @map("cancellation_reason") @db.Text
  reconciledAt          DateTime?                  @map("reconciled_at") @db.Timestamptz(6)
  reconciledById        String?                    @map("reconciled_by_id") @db.Uuid
  statementReference    String?                    @map("statement_reference") @db.VarChar(200)
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  account              FinancialAccount                 @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category             FinancialCategory                @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  costCenter           CostCenter?                      @relation(fields: [costCenterId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  paymentMethod        PaymentMethod?                   @relation("FinancialTransactionPaymentMethod", fields: [paymentMethodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payment              Payment?                         @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refund               Refund?                          @relation(fields: [refundId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  partnerSettlement    PartnerSettlement?               @relation(fields: [partnerSettlementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversesTransaction  FinancialTransaction?            @relation("FinancialTransactionReversal", fields: [reversesTransactionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversalTransactions FinancialTransaction[]           @relation("FinancialTransactionReversal")
  cashClosing          CashClosing?                     @relation(fields: [cashClosingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy            User?                            @relation("FinancialTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  confirmedBy          User?                            @relation("FinancialTransactionConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cancelledBy          User?                            @relation("FinancialTransactionCanceller", fields: [cancelledById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reconciledBy         User?                            @relation("FinancialTransactionReconciler", fields: [reconciledById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  attachments          FinancialTransactionAttachment[]
  transferAsDebit      FinancialTransfer?               @relation("TransferDebitTransaction")
  transferAsCredit     FinancialTransfer?               @relation("TransferCreditTransaction")
  settledObligation    FinancialObligation?

  @@index([accountId, status, occurredAt])
  @@index([categoryId, competenceDate])
  @@index([costCenterId, competenceDate])
  @@index([paymentMethodId, occurredAt])
  @@index([origin, status])
  @@index([reversesTransactionId])
  @@map("financial_transactions")
}

model FinancialTransfer {
  id                   String   @id @default(uuid()) @db.Uuid
  sourceAccountId      String   @map("source_account_id") @db.Uuid
  destinationAccountId String   @map("destination_account_id") @db.Uuid
