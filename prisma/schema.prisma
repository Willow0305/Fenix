  sourceAccount      FinancialAccount     @relation("TransferSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  destinationAccount FinancialAccount     @relation("TransferDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
