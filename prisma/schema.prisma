generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED
}

enum UserTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum MediaKind {
  IMAGE
  DOCUMENT
  RECEIPT
  INVOICE
  CONTRACT
  OTHER
}

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  SENSITIVE
}

enum TeamBrandContext {
  OFFICIAL
  MALE
  FEMALE
  BOARD
  FAVICON
  COVER
  OTHER
}

enum AthleteStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
  NOT_INFORMED
}

enum TeamType {
  MALE
  FEMALE
  MIXED
  OTHER
}

enum TeamMembershipStatus {
  ACTIVE
  INACTIVE
}

enum RegistrationStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  CONVERTED
}

enum TryoutStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  COMPLETED
  CANCELLED
}

enum TryoutRegistrationStatus {
  NEW
  UNDER_REVIEW
  APPROVED
  REJECTED
  ATTENDED
  NO_SHOW
  CANCELLED
}

enum InterestedPersonStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  ARCHIVED
}

enum MonthlyFeePlanStatus {
  ACTIVE
  INACTIVE
}

enum AthletePlanStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum MonthlyFeeStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethodType {
  PIX
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  BOLETO
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum FinancialAccountType {
  CASH
  BANK
  PIX
  WALLET
  CARD_CLEARING
  OTHER
}

enum FinancialCategoryNature {
  INCOME
  EXPENSE
  TRANSFER
}

enum FinancialObligationType {
  PAYABLE
  RECEIVABLE
}

enum FinancialObligationStatus {
  OPEN
  SETTLED
  OVERDUE
  CANCELLED
}

enum FinancialDirection {
  INCOME
  EXPENSE
}

enum FinancialOrigin {
  MANUAL
  MONTHLY_FEE
  ORDER
  REFUND
  PARTNER_SETTLEMENT
  TRANSFER
  OPENING_BALANCE
  ADJUSTMENT
}

enum FinancialTransactionStatus {
  DRAFT
  PENDING
  CONFIRMED
  CANCELLED
}

enum FinancialAttachmentType {
  RECEIPT
  INVOICE
  CONTRACT
  OTHER
}

enum CashClosingStatus {
  DRAFT
  CLOSED
  REOPENED
}

enum PartnerType {
  SUPPLIER
  STORE
  PROFESSIONAL
  SPONSOR
  OTHER
}

enum PartnerStatus {
  PENDING
  ACTIVE
  INACTIVE
  ENDED
}

enum ProfessionalStatus {
  ACTIVE
  INACTIVE
}

enum CommissionType {
  NONE
  PERCENTAGE
  FIXED
}

enum ServiceStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum AvailabilityStatus {
  AVAILABLE
  BLOCKED
  RESERVED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ProductFulfillmentType {
  STOCK
  MADE_TO_ORDER
  CAMPAIGN
