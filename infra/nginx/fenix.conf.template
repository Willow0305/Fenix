# Nginx na frente do site e da API (DT-053). As variáveis ${...} são preenchidas pela
# imagem oficial do Nginx ao iniciar (envsubst). Certificados em /etc/nginx/certs
# (fullchain.pem e privkey.pem), por exemplo emitidos pelo Let's Encrypt.

upstream fenix_web {
  server web:3000;
  keepalive 16;
}

upstream fenix_api {
  server api:3333;
  keepalive 16;
}

server {
  listen 80;
  listen [::]:80;
  server_name ${SERVER_NAME};

  # Renovação do certificado (Let's Encrypt, desafio HTTP).
  location /.well-known/acme-challenge/ {
    root /var/www/acme;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${SERVER_NAME};

  ssl_certificate /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:fenix_ssl:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  server_tokens off;
  # Uploads: imagens e comprovantes de até 10 MB, com folga para o formulário.
  client_max_body_size 12m;

  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_types text/plain text/css application/json application/javascript image/svg+xml;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  # Substitui (não acrescenta) o cabeçalho: o visitante não consegue forjar o próprio IP.
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header Connection "";

  # Tempo real (DT-049, DT-051): sem buffer e com conexão longa.
  location ~ ^/api/v1/(me/events|public/live)$ {
    proxy_pass http://fenix_api;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
    gzip off;
  }

  # API direto, sem passar pelo site.
  location /api/v1/ {
    proxy_pass http://fenix_api;
    proxy_read_timeout 60s;
  }

  # A rota de descarte de cache é só para a API, pela rede interna.
  location = /api/site-revalidate {
    return 404;
  }

  # Arquivos estáticos do site: nomes com hash, cache longo.
  location /_next/static/ {
    proxy_pass http://fenix_web;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location / {
    proxy_pass http://fenix_web;
    proxy_read_timeout 60s;
  }
}
